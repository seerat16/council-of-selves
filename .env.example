# =============================================================================
# Council of Selves — environment template
# Copy to `.env` and fill in the values marked HUMAN. NEVER commit `.env`.
# =============================================================================

# --- Cognee: choose ONE of the two blocks below ---

# (A) OpenAI (paid, default). Same value in both vars.
# LLM_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# (B) Ollama (FREE, local — no OpenAI key). Cognee uses LiteLLM under the hood, which
# talks to Ollama's OpenAI-compatible endpoint. VERIFY these var names against your
# installed cognee (docs.cognee.ai); run scripts/smoke_cognee.py first and adjust if
# extraction/embeddings error. `ollama serve` must be running with the models pulled:
#   ollama pull llama3.1 && ollama pull nomic-embed-text
LLM_PROVIDER=ollama
LLM_MODEL=ollama/llama3.1
LLM_ENDPOINT=http://localhost:11434
LLM_API_KEY=ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=ollama/nomic-embed-text
EMBEDDING_ENDPOINT=http://localhost:11434
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=ollama

# VERIFY: gives each dataset its own isolated graph + vector store (Section 3.2).
ENABLE_BACKEND_ACCESS_CONTROL=true

# --- Council LLM provider ---
# "anthropic" (paid) or "ollama" (free, local). Default is anthropic.
SELVES_LLM_PROVIDER=anthropic

# If SELVES_LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=sk-ant-...
SELVES_CHAIR_MODEL=claude-sonnet-5
SELVES_SELF_MODEL=claude-haiku-4-5-20251001

# If SELVES_LLM_PROVIDER=ollama (free, no key needed):
#   SELVES_LLM_PROVIDER=ollama
#   OLLAMA_URL=http://localhost:11434/v1
#   SELVES_CHAIR_MODEL=llama3.1
#   SELVES_SELF_MODEL=llama3.1
#   (ANTHROPIC_API_KEY not required)

# --- App ---
# HUMAN: absolute path to this repo on your machine (WSL2 example shown).
SELVES_HOME=/home/you/council-of-selves
SELVES_DATA=data/seed                 # or data/mine
SELVES_BRAIN_URL=http://localhost:8765
SELVES_OWNER=Alex

# --- ClawMax (used by ~/clawmax/SYSTEM/dashboard/.env, not this file) ---
# HUMAN — set these in ClawMax's own .env, see RUNBOOK.md:
#   SYSTEM_ANTHROPIC_API_KEY=sk-ant-...   (same as ANTHROPIC_API_KEY)
#   SYSTEM_OPENAI_API_KEY=sk-...          (same as OPENAI_API_KEY)
#   DASHBOARD_AUTH_MODE=bypass            (local dev only)

# --- Cognee hosted tenant (platform.cognee.ai) ---
# HUMAN: set BOTH to attach the SDK to your tenant via cognee.serve() and enable
# `selves push`. Leave unset for a purely local build. Get these from your Cognee
# tenant / the VS Code extension settings. NEVER commit the real key.
# COGNEE_SERVICE_URL=https://<your-tenant>.aws.cognee.ai
# COGNEE_API_KEY=...
